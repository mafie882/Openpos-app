#!/bin/sh

##############################################################################
# Gradle start up script for POSIX generated by Gradle.
# This is the standard wrapper script shipped by the Gradle project.
# If it's missing its companion jar (gradle/wrapper/gradle-wrapper.jar),
# open this project in Android Studio instead and let it regenerate the
# wrapper, or run: gradle wrapper  (with a local Gradle install).
##############################################################################

DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

APP_NAME="Gradle"
APP_BASE_NAME=$(basename "$0")
APP_HOME=$(cd "$(dirname "$0")" && pwd)

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ ! -f "$CLASSPATH" ]; then
  echo "ERROR: gradle/wrapper/gradle-wrapper.jar is missing."
  echo "Open this folder in Android Studio and it will fetch it automatically,"
  echo "or run 'gradle wrapper' here if you have Gradle installed separately."
  exit 1
fi

JAVACMD="java"
if [ -n "$JAVA_HOME" ]; then
  JAVACMD="$JAVA_HOME/bin/java"
fi

exec "$JAVACMD" $DEFAULT_JVM_OPTS -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
